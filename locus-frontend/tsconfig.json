{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "App.js",
    "index.js",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "dist",
    "build"
  ]
}
